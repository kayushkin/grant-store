[Unit]
Description=Grant Store — which principal may use which tool, skill, agent, instance or machine
After=network.target

[Service]
Type=simple
ExecStart=/home/kayushkincom/bin/grant-store

# Loopback, deliberately, like principal-store. This service has no auth of its
# own; dash is the front door that adds it (at /api/grants). A wildcard bind
# would put grant editing on the network for anything that can route to this
# host. main.go defaults to the same address, so an empty env is safe too.
Environment=GRANT_STORE_ADDR=127.0.0.1:8315

# Where POST /grants asks whether the principal and the resource exist, and
# where GET /principals/{id}/effective reads a human's groups: the principal
# from principal-store; agents, instances and machines through
# llm-bridge-server; skills and tools from their stores. These are the names
# dash and principal-store already read.
Environment=PRINCIPAL_STORE_URL=http://127.0.0.1:8314
Environment=LLM_BRIDGE_URL=http://127.0.0.1:8160
Environment=SKILL_STORE_URL=http://127.0.0.1:8301
Environment=TOOL_STORE_URL=http://127.0.0.1:8302

Environment=HOME=/home/kayushkincom
WorkingDirectory=/home/kayushkincom/repos/grant-store
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
